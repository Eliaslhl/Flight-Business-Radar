# ─────────────────────────────────────────────────────────────────────────────
# Flight Business Radar — exemple de configuration.
# Copier vers `.env` et renseigner. NE JAMAIS committer `.env`.
# Toutes les variables sont validées au démarrage par @fbr/config (Zod, fail-fast).
# ─────────────────────────────────────────────────────────────────────────────

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Niveau de log pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Format lisible en console (true en dev, false en prod pour du JSON structuré)
LOG_PRETTY=true

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Correspond au service `postgres` de docker-compose.yml
DATABASE_URL=postgresql://fbr:fbr@localhost:5432/fbr

# ── Redis (queue BullMQ — utilisé à partir de la Phase 3) ────────────────────
REDIS_URL=redis://localhost:6379

# ── API HTTP ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001

# ── Devise & taux de change (Phase 4) ───────────────────────────────────────
BASE_CURRENCY=EUR
# Source des taux de change : frankfurter | ecb | fixed
FX_SOURCE=frankfurter

# ── Moteur de recherche / surveillance (Phase 3) ───────────────────────────
SCHEDULER_INTERVAL_MS=15000
SEARCH_WORKER_CONCURRENCY=4
SEARCH_COMBINATIONS_PER_RUN=6
PROVIDER_MIN_INTERVAL_SECONDS=60
# Scénario du provider simulé tant qu'aucun provider réel n'est branché (Phase 7) :
# normal | gradual-drop | flash-drop | record-low | unavailable | error | timeout
MOCK_SCENARIO=normal

# ── Providers de données de vol (renseignés à partir de la Phase 7) ─────────
# Laisser vide tant que le provider n'est pas activé.
SERPAPI_API_KEY=
DUFFEL_API_TOKEN=

# ── Notifications (Phase 8) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

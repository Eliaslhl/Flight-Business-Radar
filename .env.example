# ─────────────────────────────────────────────────────────────────────────────
# Flight Business Radar — exemple de configuration.
# Copier vers `.env` et renseigner. NE JAMAIS committer `.env`.
# Toutes les variables sont validées au démarrage par @fbr/config (Zod, fail-fast).
# ─────────────────────────────────────────────────────────────────────────────

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Niveau de log pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Format lisible en console (true en dev, false en prod pour du JSON structuré)
LOG_PRETTY=true

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Correspond au service `postgres` de docker-compose.yml
DATABASE_URL=postgresql://fbr:fbr@localhost:5432/fbr

# ── Redis (queue BullMQ) ────────────────────────────────────────────────────
# OPTIONNEL. Requis pour le worker long-running (`@fbr/worker`) et l'enqueue
# manuel de l'API. Le runner one-shot `@fbr/worker/once` (cron GitHub Actions,
# déploiement gratuit) tourne sans. Absent ⇒ pas de file, dégradation propre.
REDIS_URL=redis://localhost:6379

# ── API HTTP ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
# Secret HMAC des cookies de session. DÉFINI ⇒ authentification e-mail / mot de
# passe activée sur l'API (routes /api/searches* et /api/alerts* exigent une
# session). Absent ⇒ tout est attribué à l'utilisateur de dev (pratique en local).
SESSION_SECRET=
SESSION_TTL_DAYS=30

# ── Devise & taux de change (Phase 4) ───────────────────────────────────────
BASE_CURRENCY=EUR
# Source des taux de change : frankfurter (API publique gratuite) | fixed
FX_SOURCE=frankfurter
# Taux fixes si FX_SOURCE=fixed — JSON { "USD": 1.08, "GBP": 0.85, ... } (base = BASE_CURRENCY)
FX_FIXED_RATES=

# ── Détection de baisses (Phase 4) ─────────────────────────────────────────
DROP_PCT=0.05
FLASH_DROP_PCT=0.12
FLASH_DROP_ABS_EUR=120
FLASH_WINDOW_MINUTES=90
ANALYTICS_MIN_SAMPLE=30

# ── Moteur de recherche / surveillance (Phase 3) ───────────────────────────
SCHEDULER_INTERVAL_MS=15000
SEARCH_WORKER_CONCURRENCY=4
SEARCH_COMBINATIONS_PER_RUN=6
# Mode Radar (recherche sans destination) : nb de destinations seed sondées par run.
RADAR_BATCH_SIZE=8
PROVIDER_MIN_INTERVAL_SECONDS=60
# Runner one-shot (`@fbr/worker/once`, cron) : plafond de recherches dues par run,
# et purge des price_snapshots plus vieux que N jours (0 = jamais).
ONCE_MAX_SEARCHES=100
SNAPSHOT_RETENTION_DAYS=180
# Scénario du provider simulé tant qu'aucun provider réel n'est branché (Phase 7) :
# normal | gradual-drop | flash-drop | record-low | unavailable | error | timeout
MOCK_SCENARIO=normal

# ── Providers de données de vol (renseignés à partir de la Phase 7) ─────────
# Sidecar fast-flights (services/flight-scraper). Si défini, le worker l'utilise
# à la place du MockFlightProvider.  docker compose --profile scraper up -d flight-scraper
FAST_FLIGHTS_URL=
FAST_FLIGHTS_TIMEOUT_MS=20000
# SerpApi Google Flights — PROVIDER RÉEL PAYANT (1 recherche = 1 crédit).
# Actif dès que la clé est renseignée. Un run mode Radar coûte RADAR_BATCH_SIZE crédits.
# Travelpayouts Data API — source RÉELLE GRATUITE mais EN CACHE (~48 h), surtout de l'éco.
# Token gratuit et immédiat après inscription affilié sur travelpayouts.com.
# Si c'est la seule source réelle, le worker relève le plancher d'intervalle à 3 h.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TIMEOUT_MS=20000
TRAVELPAYOUTS_MAX_DESTINATIONS=8
#
# SerpApi Google Flights — payant. Actif dès que la clé est renseignée, mais
# UNIQUEMENT sur les recherches point-à-point (une destination) : chaque passage
# interroge les 3 cabines (Éco / Éco+ / Affaires) = 3 crédits. Les radars /
# continents restent sur Travelpayouts. Plancher d'intervalle relevé à 6 h et
# 1 seul couple de dates par passage → ~360 crédits/mois pour 1 route en 6 h.
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=20000
SERPAPI_COMBINATIONS_PER_RUN=1
SERPAPI_MAX_DESTINATIONS=8  # obsolète (SerpApi n'est plus utilisé qu'en point-à-point)
# Duffel (API v2) — oracle de confirmation des baisses exceptionnelles (payant).
# Sandbox : token duffel_test_… (offres factices). Live : duffel_live_… (compte vérifié).
DUFFEL_API_TOKEN=
DUFFEL_TIMEOUT_MS=20000
DUFFEL_MAX_DESTINATIONS=4

# ── Notifications (Phase 8) ─────────────────────────────────────────────────
# Le canal `console` (logs structurés) est toujours actif. Chaque autre canal
# s'active uniquement quand TOUTE sa config est renseignée. Jamais de secret
# committé : ce fichier reste un modèle, `.env` n'est pas versionné.
#
# Telegram (gratuit, push-like) — créer un bot via @BotFather, récupérer le
# chat id en écrivant au bot puis en lisant getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Email — n'importe quel SMTP (ex. MailHog local `smtp://localhost:1025`,
# ou le relai de ton fournisseur). smtps:// pour le port 465.
SMTP_URL=
EMAIL_FROM=
EMAIL_TO=
#
# Webhook générique — POST JSON (Discord `…/webhooks/…`, Slack, ntfy, custom).
NOTIFICATION_WEBHOOK_URL=
#
# Communs à tous les canaux réseau.
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_MAX_ATTEMPTS=3

# ── AI Advisor (Phase 10) ──────────────────────────────────────────────────
# Sans clé : conseil déterministe (« rules »). Avec clé : rédaction par Claude,
# toujours repassée au garde-fou anti-invention. Secret — jamais committé.
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-sonnet-5
ADVISOR_MAX_TOKENS=600
ADVISOR_TIMEOUT_MS=20000
